# Vercel: „RESEND_API_KEY“ für „Production“ setzen + Redeploy (ohne Redeploy sieht die API den Key nicht).
#
# Kopiere nach .env.local und trage deinen Key ein (ohne Anführungszeichen).
#
# 1) https://resend.com – mit DER GLEICHEN Adresse anmelden wie LEAD_TO_EMAIL (z. B. zeichendesuniversums.info@gmail.com).
# 2) API Keys → Create → re_…
# 3) Mit onboarding@resend.dev darfst du in der Regel nur an diese Account-Mail senden.
#    Sonst: resend.com/domains – eigene Domain verifizieren, dann RESEND_FROM=noreply@deinedomain.de
# 4) Keine Mail? Resend → „Logs“ / „Emails“ prüfen; Gmail → Spam; Vercel → Function Logs (Zeile „Resend OK“ oder Fehler-JSON).

RESEND_API_KEY=re_hier_einsetzen

# Optional – Standard im Code ist zeichendesuniversums.info@gmail.com
# LEAD_TO_EMAIL=

# Optional – nur wenn Domain bei Resend verifiziert
# RESEND_FROM=Zeichen des Universums <news@deinedomain.de>
