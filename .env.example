# --- Öffentliche Site-URL (optional; Vercel Production nutzt sonst die kanonische Domain) ---
# NEXT_PUBLIC_SITE_URL=https://deine-domain.de
# SITE_URL=https://deine-domain.de

# --- Google Search Console (zwei verschiedene Property-Typen!) ---
#
# A) URL-Präfix (z. B. https://zeichendesuniversums.com/) + Bestätigung „HTML-Tag“:
#    Hier nur den TOKEN eintragen (alles nach google-site-verification=), z. B.:
#    NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abc123...
#    Optional geht auch der volle String – wird automatisch gekürzt.
#
# B) Domain-Property (nur domain.tld, ohne https):
#    DNS-TXT beim DOMAIN-ANBIETER (nicht in Vercel/Next.js): neuen TXT-Eintrag,
#    Wert exakt wie in der Search Console angezeigt, oft:
#    google-site-verification=DEIN_TOKEN
#    DNS-Propagation kann Stunden dauern. Meta-Tag auf der Website reicht für (B) NICHT.
#
# https://search.google.com/search-console
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Google Analytics 4 (optional; Mess-ID aus GA, beginnt mit G-) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# 1) Dashboard: Testmodus → Developers → API keys → Secret key kopieren (sk_test_…).
# 2) Hier eintragen und App neu starten. Ohne Key: lokales next dev nur mit Stub-Checkout;
#    auf Vercel/Production kein Profil-Link ohne diesen Key.
# Test: sk_test_...  |  Live: sk_live_...
STRIPE_SECRET_KEY=

# Webhook-Signing Secret (Dashboard → Webhooks → Endpoint → Signing secret, beginnt mit whsec_)
# Lokal: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Profil-Zugangslink (HMAC auf /success) ---
# Empfohlen: eigenes Secret (openssl rand -hex 32). Wenn leer: es wird ein Schlüssel
# aus STRIPE_SECRET_KEY abgeleitet (funktioniert auf Vercel sobald Stripe gesetzt ist).
PROFILE_ACCESS_SECRET=

# --- E-Mail (Resend, https://resend.com) – Profil-Link von /success ---
# Standard: RESEND_API_KEY (gleicher Key wie Lead-Mail). Optional nur ZD_RESEND_PROFILE_KEY,
# wenn kein RESEND_API_KEY – sind beide gesetzt, gewinnt RESEND_API_KEY.
RESEND_API_KEY=
ZD_RESEND_PROFILE_KEY=
# Lokal testen: npm run test:resend -- deine@email.de
# Absender (optional): Wenn leer: noreply@ + Host aus der Site-URL (Production).
# Wenn Resend z. B. nur "zeichendesuniversums.com" hat, Site-URL aber .info ist:
#   ZD_MAIL_DOMAIN=zeichendesuniversums.com
ZD_MAIL_DOMAIN=
# Oder komplett manuell: RESEND_FROM=Zeichen des Universums <hello@zeichendesuniversums.com>
RESEND_FROM=
