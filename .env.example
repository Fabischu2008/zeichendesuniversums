# Vercel: Variable „RESEND_API_KEY“ für Umgebung „Production“ setzen (nicht nur Preview),
# dann Deployment neu auslösen („Redeploy“).
#
# Kopiere nach .env.local und trage deinen Key ein (ohne Anführungszeichen).
#
# 1) https://resend.com anmelden (z. B. mit fabianschuck13@gmail.com)
# 2) API Keys → Create → Key beginnt mit re_
# 3) Mit Absender "onboarding@resend.dev" gehen Test-Mails an deine
#    Resend-Account-E-Mail (z. B. fabianschuck13@gmail.com).
#    Andere Empfänger: eigene Domain bei Resend verifizieren + RESEND_FROM setzen.

RESEND_API_KEY=re_hier_einsetzen

# Optional – Standard im Code ist fabianschuck13@gmail.com
# LEAD_TO_EMAIL=

# Optional – nur wenn Domain bei Resend verifiziert
# RESEND_FROM=Zeichen des Universums <news@deinedomain.de>
