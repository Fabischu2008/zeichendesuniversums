# --- Öffentliche Site-URL (optional; Vercel Production nutzt sonst die kanonische Domain) ---
# NEXT_PUBLIC_SITE_URL=https://deine-domain.de
# SITE_URL=https://deine-domain.de

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Test: sk_test_...  |  Live: sk_live_...
STRIPE_SECRET_KEY=

# Webhook-Signing Secret (Dashboard → Webhooks → Endpoint → Signing secret, beginnt mit whsec_)
# Lokal: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Profil-Zugangslink (HMAC auf /success) ---
# Empfohlen: eigenes Secret (openssl rand -hex 32). Wenn leer: es wird ein Schlüssel
# aus STRIPE_SECRET_KEY abgeleitet (funktioniert auf Vercel sobald Stripe gesetzt ist).
PROFILE_ACCESS_SECRET=
